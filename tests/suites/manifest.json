{
  "schemaVersion": 1,
  "profiles": {
    "quick": {
      "includes": [],
      "commands": [
        "suite-manifest",
        "root-shipping-tests",
        "converter-tests",
        "format-tests",
        "hash-tests",
        "javascript-unit-tests",
        "core-types",
        "shim-types",
        "unicode-table-identity"
      ]
    },
    "artifacts": {
      "includes": [],
      "commands": [
        "build-execution-artifacts",
        "execution-artifact-manifest"
      ]
    },
    "correctness": {
      "includes": [],
      "commands": [
        "overlap-parity",
        "hash-portability",
        "build-execution-artifacts",
        "execution-artifact-manifest",
        "feature-composition",
        "bun-shims",
        "deno-cli",
        "workerd-edge",
        "vercel-edge",
        "oracle-parity",
        "simd-parity",
        "reserved-policy",
        "shim-fidelity",
        "build-browser-fixtures",
        "tier-parity",
        "tier-switch",
        "decode-round-trip",
        "starts-fidelity"
      ]
    },
    "release": {
      "includes": ["quick", "artifacts"],
      "commands": [
        "prepare-release-package",
        "core-package-install",
        "release-artifact",
        "configuration-contract",
        "publish-independence",
        "build-demo",
        "demo-static",
        "demo-browser",
        "demo-throughput"
      ]
    },
    "mutation": {
      "includes": ["artifacts"],
      "commands": ["mutation-contracts"]
    }
