      "id": "hash-tests",
      "cwd": ".",
      "executable": "cargo",
      "arguments": ["test", "--locked", "--all-features", "--manifest-path", "hypertok-hash/Cargo.toml"]
    },
    {
      "id": "javascript-unit-tests",
      "cwd": "hypertok-js",
      "executable": "node",
      "arguments": [
        "--test",
        "tests/core-package.test.mjs",
        "tests/module-source.test.mjs",
        "tests/vocab-resolve.test.mjs",
        "tests/decode-assembly.test.mjs",
        "tests/decode-boundary.test.mjs",
        "tests/decode-composed.test.mjs",
        "tests/decode-hotstrings.test.mjs",
        "tests/decode-id-scratch.test.mjs",
        "tests/decode-table.test.mjs",
        "tests/runtime-decode-wiring.test.mjs",
        "tests/tier-runtime-lifecycle.test.mjs",
        "tests/public-decode-config.test.mjs",
        "tests/huggingface-lazy-shim.test.mjs"
      ]
    },
    {
      "id": "core-types",
      "cwd": ".",
