  "commands": [
    {
      "id": "suite-manifest",
      "cwd": ".",
      "executable": "node",
      "arguments": ["tests/suites/verify_manifest.mjs"]
    },
    {
      "id": "root-shipping-tests",
      "cwd": ".",
      "executable": "cargo",
      "arguments": [
        "test",
        "--locked",
        "--no-default-features",
        "--features",
        "portable-json,wasm-binding,htk,sentencepiece-core,source-loaders,opt-marshalling,opt-chunk-prescan,opt-scan-two-phase,opt-level-select,opt-cold-diet,opt-fused-pair-ranks,opt-compact-ranks,opt-decode-assembly",
        "--lib",
        "--tests",
        "--",
        "--skip",
        "_owt",
        "--skip",
        "owt_tests::",
        "--skip",
        "basic_tokenization",
        "--skip",
        "test_merges_from_vocab",
        "--skip",
        "test_pretokenizer_ts",
        "--skip",
        "test_safe_split_ranges_pretoken_equivalent"
      ]
    },
    {
      "id": "converter-tests",
      "cwd": ".",
      "executable": "cargo",
      "arguments": ["test", "--locked", "--manifest-path", "hypertok-converter/Cargo.toml"]
    },
    {
      "id": "format-tests",
      "cwd": ".",
